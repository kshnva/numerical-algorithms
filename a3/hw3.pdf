    "# Table of results for comparison\n",
    "methods = [\"Gauss-Newton\", \"Levenberg-Marquardt\", \"Adaptive Levenberg-Marquardt\"]\n",
    "starting_points = [x0_1, x0_1, x0_1, x0_2, x0_2, x0_2, x0_3, x0_3, x0_3]\n",
