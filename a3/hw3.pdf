     "name": "stdout",
     "output_type": "stream",
     "text": [
      " Gauss-Newton: c1 = 9.80, c2 = -0.22, Iterations = 7\n",
      " Levenberg-Marquardt: c1 = 9.80, c2 = -0.22, Iterations = 10\n",
      " Adaptive Levenberg-Marquardt: c1 = 9.80, c2 = -0.22, Iterations = 7\n"
     ]
    }
   ],
   "source": [
    "x0_1 = np.array([3.0, -0.1])\n",
    "\n",
    "# Gauss-Newton\n",
    "gn_result_1, gn_iterations_1 = gauss_newton(func, jacobian, hour, x0_1, concentration)\n",
    "print(f\" Gauss-Newton: c1 = {gn_result_1[0]:.2f}, c2 = {gn_result_1[1]:.2f}, Iterations = {gn_iterations_1}\")\n",
    "\n",
    "# Levenberg-Marquardt\n",
    "lm_result_1, lm_iterations_1 = levenberg_marquardt(func, jacobian, hour, x0_1, concentration, mu=0.1)\n",
    "print(f\" Levenberg-Marquardt: c1 = {lm_result_1[0]:.2f}, c2 = {lm_result_1[1]:.2f}, Iterations = {lm_iterations_1}\")\n",
    "\n",
    "# Adaptive Levenberg-Marquardt\n",
    "alm_result_1, alm_iterations_1 = adaptive_levenberg_marquardt(func, jacobian, hour, x0_1, concentration, mu=0.1)\n",
    "print(f\" Adaptive Levenberg-Marquardt: c1 = {alm_result_1[0]:.2f}, c2 = {alm_result_1[1]:.2f}, Iterations = {alm_iterations_1}\")"
   ]
